# Postgres của blog (production: DB mới, ví dụ Neon). Máy local: Postgres bất kỳ.
DATABASE_URL=postgres://postgres@127.0.0.1:5433/realusers_blog
# Chuỗi ngẫu nhiên dài, mã hoá phiên đăng nhập trang quản trị: openssl rand -hex 32
PAYLOAD_SECRET=
# URL gốc của site (canonical, sitemap, og:url). Production: https://www.realusers.net
NEXT_PUBLIC_SERVER_URL=http://localhost:3100
# Bí mật cho nút "Xem trước" bản nháp: openssl rand -hex 16
PREVIEW_SECRET=
# Vercel Cron gửi kèm "Authorization: Bearer <CRON_SECRET>" để chạy việc hẹn giờ đăng bài
CRON_SECRET=
# Cloudflare R2 (bắt buộc ở production, bỏ trống ở local thì ảnh lưu vào ./media)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Link công khai của bucket, ví dụ https://media.realusers.net (không có / cuối)
R2_PUBLIC_BASE_URL=
