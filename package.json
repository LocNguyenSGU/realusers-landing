{
  "name": "realusers-web",
  "version": "1.0.0",
  "private": true,
  "description": "www.realusers.net: landing + blog RealUsers (Next.js + Payload CMS)",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "ci": "npm run db:migrate && npm run build",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "db:migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "db:migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "seed:old-posts": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seedOldPosts.ts",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:int",
    "test:unit": "vitest run --config ./vitest.config.mts --project unit",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts --project int",
    "test:e2e": "playwright test --config=playwright.config.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/plugin-redirects": "3.92.1",
    "@payloadcms/plugin-seo": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/storage-s3": "3.92.1",
    "@payloadcms/storage-vercel-blob": "3.92.1",
    "@payloadcms/translations": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "cross-env": "7.0.3",
    "dotenv": "16.4.7",
    "graphql": "16.11.0",
    "jsdom": "28.0.0",
    "next": "16.4.3",
    "payload": "3.92.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "schema-dts": "1.1.5",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "happy-dom": "21.0.4"
  }
}
